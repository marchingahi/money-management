rules_version = '2';

// Firebase コンソールの「Firestore Database → ルール」に設定する。
// ログインした本人だけが、自分の kakeibo/{uid} 以下を読み書きできる。
// 既存のルールがあるプロジェクトでは、既存の match ブロックは残したまま、
// kakeibo の match ブロックだけを追加する。
service cloud.firestore {
  match /databases/{database}/documents {
    match /kakeibo/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
